{
  "name": "decky-renodx",
  "version": "0.6.0",
  "description": "Decky Loader plugin: per-game HDR for Proton games via RenoDX, Special K or ReShade AutoHDR",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "node scripts/test.js",
    "test:backend": "python3 -m unittest discover -s tests -t .",
    "test:launch": "node --experimental-strip-types tests/launchOptions.test.ts",
    "test:types": "tsc --noEmit --skipLibCheck",
    "compat:validate": "python3 scripts/compat_db.py validate",
    "compat:report": "python3 scripts/compat_db.py report",
    "compat:sync": "python3 scripts/compat_db.py sync-renodx",
    "package": "python3 scripts/create_zip.py",
    "release": "node scripts/release.js",
    "dev": "node dev/build.mjs && python3 dev/server.py",
    "dev:watch": "node dev/build.mjs --watch & python3 dev/server.py",
    "dev:screens": "node dev/screens.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Feelsrat/decky-renodx.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "hdr",
    "renodx",
    "proton",
    "steam-deck",
    "deck"
  ],
  "author": "Feelsrat",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/Feelsrat/decky-renodx/issues"
  },
  "homepage": "https://github.com/Feelsrat/decky-renodx#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "esbuild": "~0.25.12",
    "playwright-core": "~1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
